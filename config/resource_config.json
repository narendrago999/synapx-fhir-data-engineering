{
  "base_url": "https://hapi.fhir.org/baseR4",
  "resources": [
    "Patient",
    "Encounter",
    "Observation",
    "Condition"
  ],
  "page_size": 100,
  "accept": "application/fhir+json",
  "pagination": {
    "strategy": "bundle_next_link",
    "relation": "next"
  },
  "incremental": {
    "parameter": "_lastUpdated",
    "prefix": "ge",
    "overlap_minutes": 5
  }
}